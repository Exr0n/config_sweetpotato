{
  "title": "Helium Ctrl+Tab MRU (enable only after extension shortcuts are configured)",
  "rules": [
    {
      "description": "Helium Ctrl+Tab to Ctrl+Y; Ctrl+Shift+Tab to Ctrl+Shift+Y, preserving held Control for release-to-switch",
      "manipulators": [
        {
          "type": "basic",
          "from": {
            "key_code": "tab",
            "modifiers": {
              "mandatory": [
                "control"
              ],
              "optional": [
                "shift"
              ]
            }
          },
          "to": [
            {
              "key_code": "y",
              "modifiers": [
                "left_control"
              ]
            }
          ],
          "conditions": [
            {
              "type": "frontmost_application_if",
              "bundle_identifiers": [
                "^net\\.imput\\.helium$"
              ]
            }
          ]
        }
      ]
    }
  ]
}
