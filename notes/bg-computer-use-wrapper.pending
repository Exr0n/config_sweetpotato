#!/usr/bin/env python3
"""Fail-closed window-scoped Cua Driver CLI. JSON args are stdin or argv[2]."""
import json, os, subprocess, sys
D=os.environ.get("BG_CUA_DRIVER","/opt/homebrew/bin/cua-driver")
READ={"list_apps","list_windows","get_window_state","get_cursor_position","check_permissions","verify_state"}
ACT={"click","double_click","right_click","set_value","type_text","press_key","hotkey","scroll","drag"}
def die(s):
    print("bg-computer-use: "+s,file=sys.stderr); sys.exit(2)
def check(x):
    if isinstance(x,dict):
        for k,v in x.items():
            if k=="delivery_mode" and v!="background": die("foreground delivery forbidden")
            if k=="foreground_fallback" and v: die("foreground fallback forbidden")
            if k=="scope" and v!="window": die("desktop scope forbidden")
            if k=="target" and (not isinstance(v,dict) or v.get("kind")!="window"): die("desktop target forbidden")
            check(v)
    elif isinstance(x,list):
        for v in x: check(v)
def main():
    if len(sys.argv)<2: die("usage: bg-computer-use TOOL [JSON]; use cua-driver describe TOOL for arguments")
    name=sys.argv[1]
    if name not in READ|ACT: die("tool not permitted by background-only wrapper")
    try:
        a=json.loads(sys.argv[2] if len(sys.argv)>2 else (sys.stdin.read() if not sys.stdin.isatty() else "{}") or "{}")
    except json.JSONDecodeError: die("invalid JSON")
    if not isinstance(a,dict): die("arguments must be a JSON object")
    check(a)
    if name in ACT:
        t=a.get("target",{})
        token=a.get("element_token")
        exact=(a.get("pid") and a.get("window_id")) or (t.get("pid") and t.get("window_id"))
        if not (token or exact): die("actions require an element token or exact pid and window_id")
        if a.get("modifier"): die("modified pixel click may require foreground")
    try:
        st=subprocess.run([D,"permissions","status","--json"],capture_output=True,text=True,check=True)
        status=json.loads(st.stdout)
    except (OSError,subprocess.SubprocessError,ValueError): die("cannot verify driver permission status")
    if status.get("accessibility") is not True or status.get("screen_recording") is not True or status.get("source",{}).get("attribution") != "driver-daemon": die("driver-owned Accessibility and Screen Recording grants not verified; no action taken")
    os.execv(D,[D,"call",name,json.dumps(a,separators=(",",":"))])
if __name__=="__main__": main()
